# ─── Site ────────────────────────────────────────────────────────────────────
# Host canónico. TEM de ser o `www`: o apex (barbeariaofbrothers.pt) redireciona
# para www na Vercel, por isso declarar o apex em canonicals/sitemap faria o
# Google seguir um redirect a partir do próprio URL canónico.
#
# Definir apenas no ambiente de Production da Vercel. Se for definida a nível de
# projeto, os deploys de preview passam a declarar canonicals de produção — o
# `siteUrl()` em src/lib/utils.ts tem uma salvaguarda para isso, mas o correto
# é limitar o âmbito na dashboard.
NEXT_PUBLIC_SITE_URL=https://www.barbeariaofbrothers.pt

# Override em runtime, sem precisar de rebuild. Usada também pelo `seo:check`.
# SITE_URL=https://www.barbeariaofbrothers.pt

# ─── Analytics ───────────────────────────────────────────────────────────────
# Google Analytics 4 — gratuito. O código já está implementado em
# `src/components/public/cookie-banner.tsx` e só carrega depois de o visitante
# aceitar os cookies; sem esta variável, nada é carregado.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
#
# Os eventos próprios (page_view, booking_click, whatsapp_checkout...) são
# gravados na tabela `events` do Supabase via /api/analytics e não precisam de
# configuração nenhuma.

# ─── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave de serviço — só no servidor, nunca exposta ao cliente.
# Sem ela o sitemap fica sem unidades, barbeiros e produtos.
SUPABASE_SERVICE_ROLE_KEY=
